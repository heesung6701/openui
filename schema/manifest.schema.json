{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "openui": {
      "type": "string",
      "const": "0.1"
    },
    "info": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "version"
      ],
      "additionalProperties": false
    },
    "tokens": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checklists": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "openui",
    "info",
    "tokens",
    "components"
  ],
  "additionalProperties": false
}
